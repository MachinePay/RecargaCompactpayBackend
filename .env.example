APP_VERSION=dev
# Vazio = SQLite local (carregador.db). Producao: Postgres.
DATABASE_URL=
ADMIN_API_KEY=troque-esta-chave

# Mercado Pago (Orders API, cobranca na Point)
MP_ACCESS_TOKEN=
# true = nao chama o MP; aprova pela rota /simular-pagamento (bancada)
MP_SIMULADO=true
AUTO_ESTORNO=true
COBRANCA_EXPIRA_SEGUNDOS=180

# OCPP
OCPP_HEARTBEAT_INTERVAL=60
TEMPO_MAXIMO_INICIO_SEGUNDOS=180
STOP_RETRY_SEGUNDOS=15
OCPP_TAGS_MESTRE=

START_SESSOES_WORKER=true
SESSOES_WORKER_INTERVAL_SECONDS=2
START_COBRANCAS_POLLER_WORKER=true
COBRANCAS_POLLER_INTERVAL_SECONDS=5
CORS_ALLOWED_ORIGINS=
